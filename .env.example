# 兰台记忆（Lantai）环境变量配置
# 复制为 .env 并填入实际值

# 安全
API_KEY=your-secret-api-key-here

# 服务配置
PORT=8767
# 数据根目录——为空时自动解析仓库根（__file__ 自推导）
# LANTAI_HOME=

# OpenAI / 硅基流动
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBED_MODEL=BAAI/bge-m3

# 定时任务
INGEST_CRON_MINUTES=60
EVOLVE_CRON_MINUTES=30
FORGET_CRON_HOURS=24

# 闸门配置
GATE_MIN_EXTRACTOR_CONF=0.55
PROMOTE_SEMANTIC_MIN_SOURCES=2
WORKING_MEMORY_TTL_DAYS=60
