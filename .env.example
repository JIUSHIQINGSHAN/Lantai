# 兰台记忆（Lantai）环境变量配置
# 复制为 .env 并填入实际值

# 安全
API_KEY=your-secret-api-key-here

# 服务配置
PORT=8767
# 数据根目录——为空时自动解析仓库根（__file__ 自推导）
# LANTAI_HOME=

# OpenAI / 硅基流动
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBED_MODEL=BAAI/bge-m3

# 定时任务
INGEST_CRON_MINUTES=60
EVOLVE_CRON_MINUTES=30
FORGET_CRON_HOURS=24

# 司天（后台运行监控面板，ADR-0044）
MONITOR_ENABLED=true
MONITOR_WINDOW_SECONDS=900
MONITOR_PERSIST_SLOW_MS=800
MONITOR_PERSIST_SAMPLE=20
MONITOR_RETENTION_DAYS=7
# 告警阈值
MONITOR_ALERT_ERROR_RATE=0.05
MONITOR_ALERT_P95_MS=3000
MONITOR_ALERT_ZERO_RECALL_RATE=0.35
MONITOR_ALERT_BACKLOG=200
MONITOR_ALERT_DB_MB=1024

# 闸门配置
GATE_MIN_EXTRACTOR_CONF=0.55
PROMOTE_SEMANTIC_MIN_SOURCES=2
WORKING_MEMORY_TTL_DAYS=60
