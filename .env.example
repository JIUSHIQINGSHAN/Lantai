# 兰台记忆（Lantai）环境变量配置
# 复制为 .env 并填入实际值

# 安全
API_KEY=your-secret-api-key-here
# lane 级 ACL：agent_id → lane 白名单（JSON dict，如 {"agent-1": ["fact", "rule"]}）；空 = 不启用
AGENT_LANE_BINDINGS={}

# 服务配置
PORT=8767
# 数据根目录——显式 LANTAI_HOME > 旧 REMEMBRANCE_HOME > 已有用户库 > 源码根
# 用户库：Windows 用户主目录下 AppData/Local/remembrance-data；
# Linux/macOS ~/.remembrance-data。仅在该目录已有 remembrance.db 时自动沿用。
# 数据目录不改变配置文件位置；.env 始终从 lantai/core/settings.py 对应的源码根读取。
LANTAI_HOME=

# OpenAI 兼容端点：以下显式选用硅基流动示例，并非出厂默认值
# 未配置时 OPENAI_BASE_URL=https://api.openai.com/v1、LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBED_MODEL=BAAI/bge-m3

# 重排（硅基流 /v1/rerank）；false = 混合检索跳过 rerank（省一次外部调用）
RERANKER_ENABLED=true
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
# 独立精排密钥；留空仅在与 OPENAI_BASE_URL 同 host 时复用 OPENAI_API_KEY
# 跨服务商且未配独立密钥时跳过精排，不外发上游密钥
RERANKER_API_KEY=

# 定时任务
INGEST_CRON_MINUTES=60
EVOLVE_CRON_MINUTES=30
FORGET_CRON_HOURS=24

# 司天（后台运行监控面板，ADR-0044）
MONITOR_ENABLED=true
MONITOR_WINDOW_SECONDS=900
MONITOR_PERSIST_SLOW_MS=800
MONITOR_PERSIST_SAMPLE=20
MONITOR_RETENTION_DAYS=7
# 告警阈值
MONITOR_ALERT_ERROR_RATE=0.05
MONITOR_ALERT_P95_MS=3000
MONITOR_ALERT_ZERO_RECALL_RATE=0.35
MONITOR_ALERT_BACKLOG=200
MONITOR_ALERT_DB_MB=1024

# 闸门配置
GATE_MIN_EXTRACTOR_CONF=0.55
PROMOTE_SEMANTIC_MIN_SOURCES=2
WORKING_MEMORY_TTL_DAYS=60
